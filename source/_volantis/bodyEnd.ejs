<script>
    (function () {
        const target = document.getElementById('hitokoto');
        if (!target) return;

        fetch('<%- url_for("/hitokoto/sentences.md") %>')
            .then((res) => res.text())
            .then((text) => {
                const lines = text
                    .split(/\r?\n/)
                    .map((line) => line.trim())
                    .filter((line) => line.startsWith('- '))
                    .map((line) => line.replace(/^\-\s+/, '').trim())
                    .filter(Boolean);

                if (!lines.length) return;
                const pick = lines[Math.floor(Math.random() * lines.length)];
                target.textContent = pick;
            })
            .catch(() => {
                // keep default text
            });
    })();
</script>