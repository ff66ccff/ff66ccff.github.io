---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<aside class="toc-column" aria-label="文章目录">
  <nav class="toc">
    <span class="toc-head">目录 / Contents</span>
    {
      items.length > 0 ? (
        <ul class="toc-list">
          {items.map((heading) => (
            <li class="toc-item">
              <a class={`toc-link depth-${heading.depth}`} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <span class="toc-empty">本文没有小标题</span>
      )
    }
  </nav>
</aside>
