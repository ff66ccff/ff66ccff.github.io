---
import type { FriendItem } from '../lib/site';
import Icon from './Icon.astro';

interface Props {
  item: FriendItem;
}

const { item } = Astro.props;
---

<a
  class="friend-card"
  href={item.url}
  target="_blank"
  rel="noopener noreferrer"
  style={`--friend-color: ${item.color ?? 'var(--accent)'}`}
>
  <img
    class="friend-avatar"
    src={item.avatar}
    alt={`${item.title} 的头像`}
    width="48"
    height="48"
    loading="lazy"
    decoding="async"
    referrerpolicy="no-referrer"
  />
  <span class="friend-body">
    <span class="friend-name">{item.title}</span>
    <span class="friend-desc">{item.description}</span>
    {item.keywords && item.keywords.length > 0 && (
      <span class="friend-keywords">
        {item.keywords.map((keyword) => (
          <span class="friend-keyword">{keyword}</span>
        ))}
      </span>
    )}
    <span class="friend-url">
      <Icon name="link" size={10} /> {item.url.replace(/^https?:\/\//, '')}
    </span>
  </span>
</a>
