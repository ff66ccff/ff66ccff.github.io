<script>
  type MermaidApi = {
    initialize: (options: Record<string, unknown>) => void;
    run: (options: { nodes: HTMLElement[] }) => Promise<void>;
  };

  async function loadMermaid(): Promise<MermaidApi | null> {
    try {
      const module = await import('mermaid');
      return (module.default ?? module) as unknown as MermaidApi;
    } catch {
      return null;
    }
  }

  function escapeHtml(value: string): string {
    return value.replace(/[&<>]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[char] ?? char);
  }

  async function renderMermaid() {
    const nodes = [
      ...document.querySelectorAll<HTMLElement>(
        '.prose pre > code.language-mermaid, .prose .mermaid:not([data-mermaid="ready"])',
      ),
    ];
    if (!nodes.length) return;

    const mermaid = await loadMermaid();
    if (!mermaid) return;

    const isDark = document.documentElement.dataset.theme === 'dark';
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: isDark ? 'dark' : 'default',
      fontFamily: 'inherit',
    });

    for (const node of nodes) {
      let container: HTMLElement;
      let source = '';

      if (node.tagName === 'CODE' && node.parentElement?.tagName === 'PRE') {
        source = node.textContent ?? '';
        container = document.createElement('div');
        container.className = 'mermaid';
        container.dataset.source = source;
        container.textContent = source;
        node.parentElement.replaceWith(container);
      } else {
        container = node;
        source = container.dataset.source ?? '';
        container.textContent = source;
      }

      if (!source.trim()) continue;

      try {
        await mermaid.run({ nodes: [container] });
        container.dataset.mermaid = 'ready';
      } catch {
        container.innerHTML = `<pre><code class="language-mermaid">${escapeHtml(source)}</code></pre>`;
      }
    }
  }

  document.addEventListener('astro:page-load', renderMermaid);
  document.addEventListener('themechange', () => {
    document.querySelectorAll<HTMLElement>('.mermaid[data-mermaid="ready"]').forEach((node) => {
      node.removeAttribute('data-mermaid');
      // mermaid 会给渲染过的节点打上 data-processed，重绘前必须清掉，否则 run() 会跳过它
      node.removeAttribute('data-processed');
      node.textContent = node.dataset.source ?? '';
    });
    void renderMermaid();
  });
</script>
