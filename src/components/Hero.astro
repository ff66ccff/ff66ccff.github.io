---
import Hitokoto from './Hitokoto.astro';
import SocialLinks from './SocialLinks.astro';
import Icon from './Icon.astro';
import { profile } from '../lib/site';
import { SITE } from '../consts';
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="hero-eyebrow">
        <span class="status-dot"></span>
        欢迎来到 {SITE.author} 的个人主页
      </span>

      <h1 class="hero-title">
        <span class="hero-id gradient-text">{profile.name}</span>
        <span class="hero-cn">代码 · VOCALOID · 科幻</span>
      </h1>

      <p class="hero-desc">{profile.description}</p>

      <div class="hero-meta">
        <span><Icon name="user" size={13} /> 四川大学 · 计算机</span>
        <span aria-hidden="true">|</span>
        <span>中文 VOCALOID</span>
        <span aria-hidden="true">|</span>
        <span>科幻小说</span>
      </div>

      <SocialLinks />
    </div>

    <div class="hero-side">
      <div class="hero-portrait">
        <span class="hero-portrait-ring" aria-hidden="true"></span>
        <img
          src={profile.avatar}
          alt={`${profile.name} 的头像`}
          width="192"
          height="192"
          loading="eager"
          decoding="async"
        />
      </div>
      <Hitokoto />
    </div>
  </div>
</section>
