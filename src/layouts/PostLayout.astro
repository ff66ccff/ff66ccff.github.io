---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import Mermaid from '../components/Mermaid.astro';
import Icon from '../components/Icon.astro';
import type { AdjacentPosts, Post } from '../lib/posts';
import { postPath } from '../lib/posts';
import { cnDate, excerpt, isoDateTime, readingTime, slugifyTerm } from '../lib/format';
import { SITE } from '../consts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  adjacent: AdjacentPosts;
}

const { post, headings, adjacent } = Astro.props;
const { title, date, updated, categories, tags } = post.data;
const body = post.body ?? '';
const description = post.data.description ?? excerpt(body, 140);
const minutes = readingTime(body);
const absolute = new URL(postPath(post), SITE.url).toString();
const image = post.data.image ?? '/og-default.jpg';

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDateTime(date),
  dateModified: isoDateTime(updated ?? date),
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
  mainEntityOfPage: absolute,
  url: absolute,
  image: new URL(image, SITE.url).toString(),
  articleSection: categories,
  keywords: tags.join(', '),
  inLanguage: SITE.locale,
};
---

<BaseLayout title={title} description={description} type="article" jsonLd={articleJsonLd}>
  <div class="container article-layout">
    <article class="article">
      <header class="article-header">
        {
          categories.length > 0 && (
            <div class="article-categories">
              {categories.map((category) => (
                <a class="tag" href={`/categories/${slugifyTerm(category)}/`}>
                  {category}
                </a>
              ))}
            </div>
          )
        }

        <h1 class="article-title">{title}</h1>

        <div class="article-meta">
          <span><Icon name="calendar" size={13} /> <time datetime={isoDateTime(date)}>{cnDate(date)}</time></span>
          <span class="sep">·</span>
          <span><Icon name="clock" size={13} /> {minutes} 分钟阅读</span>
          {updated && updated.valueOf() !== date.valueOf() && (
            <>
              <span class="sep">·</span>
              <span>更新于 {cnDate(updated)}</span>
            </>
          )}
        </div>

        {
          tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <a class="tag" href={`/tags/${slugifyTerm(tag)}/`}>#{tag}</a>
              ))}
            </div>
          )
        }
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="article-footer">
        <Giscus />

        <nav class="post-nav" aria-label="上一篇 / 下一篇">
          {
            adjacent.prev ? (
              <a class="post-nav-item" href={postPath(adjacent.prev)}>
                <span class="post-nav-label">← 更早</span>
                <span class="post-nav-title">{adjacent.prev.data.title}</span>
              </a>
            ) : (
              <span></span>
            )
          }
          {
            adjacent.next ? (
              <a class="post-nav-item is-next" href={postPath(adjacent.next)}>
                <span class="post-nav-label">更新 →</span>
                <span class="post-nav-title">{adjacent.next.data.title}</span>
              </a>
            ) : (
              <span></span>
            )
          }
        </nav>
      </footer>
    </article>

    <Toc headings={headings} />
  </div>
  <Mermaid />
</BaseLayout>
