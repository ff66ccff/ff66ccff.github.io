---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  kicker?: string;
  description?: string;
  icon?: string;
}

const { title, kicker, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <header class="page-header">
      {kicker && <span class="page-kicker">{kicker}</span>}
      <h1 class="page-title">{title}</h1>
      {description && <p class="page-desc">{description}</p>}
    </header>
    <slot />
  </div>
</BaseLayout>
