---
import PageLayout from '../../layouts/PageLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { profile } from '../../lib/site';

const facts = [
  { label: '学校', value: '四川大学' },
  { label: '专业', value: '计算机' },
  { label: '兴趣', value: '中文 VOCALOID · 科幻小说 · 算法竞赛' },
  { label: '站点', value: '2017 年开始记录，2026 年用 Astro 重构' },
];
---

<PageLayout title="关于" kicker="About" description="写代码，听 VOCALOID，读科幻，偶尔记录生活。">
  <div class="about-grid">
    <div class="about-card">
      <p class="about-intro">
        你好，我是 <strong>{profile.name}</strong>，四川大学计算机专业的学生。
        这个站点是我技术与生活的手记：既有 C++ / 算法 / 工程实践，也有 VOCALOID、科幻与一些零散的日常。
      </p>
      <p class="about-intro">
        我相信长期的记录比短暂的表达更有价值，所以这里从 2017 年一直写到现在。
        旧站使用 Hexo + Volantis；2026 年迁移到 <strong>Astro</strong>，
        保留全部文章、友链与个人资料，只把体验做得更干净一点。
      </p>

      <ul class="about-facts">
        {
          facts.map((fact) => (
            <li class="about-fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </li>
          ))
        }
      </ul>

      <div style="margin-top: 1.6rem;">
        <SocialLinks />
      </div>
    </div>

    <div class="about-side">
      <div class="about-portrait">
        <img
          src={profile.avatar}
          alt={`${profile.name} 的头像`}
          width="480"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="about-card">
        <h2 class="section-title" style="margin-bottom: 0.8rem;">本站</h2>
        <p class="about-intro" style="font-size: 0.9rem;">
          使用 Astro 构建，部署在 GitHub Pages。文章内容遵循 CC BY-NC-SA 4.0 协议，欢迎引用但请注明出处。
        </p>
      </div>
    </div>
  </div>
</PageLayout>
