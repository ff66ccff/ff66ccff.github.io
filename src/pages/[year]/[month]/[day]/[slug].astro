---
import { render } from 'astro:content';
import PostLayout from '../../../../layouts/PostLayout.astro';
import { getPublishedPosts, getAdjacentPosts } from '../../../../lib/posts';
import { dateParts } from '../../../../lib/format';
import type { Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    const { year, month, day } = dateParts(post.data.date);
    return {
      params: { year, month, day, slug: post.id },
      props: { post },
    };
  });
}

interface Props {
  post: Post;
}

const { post } = Astro.props as Props;
const { Content, headings } = await render(post);
const posts = await getPublishedPosts();
const adjacent = getAdjacentPosts(posts, post);
---

<PostLayout post={post} headings={headings} adjacent={adjacent}>
  <Content />
</PostLayout>
