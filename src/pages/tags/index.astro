---
import PageLayout from '../../layouts/PageLayout.astro';
import { getPublishedPosts, collectTerms } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = collectTerms(posts, 'tags');
---

<PageLayout title="标签" kicker="Tags" description={`共 ${tags.length} 个标签。`}>
  <ul class="taxonomy-grid">
    {
      tags.map((term) => (
        <li>
          <a class="term-card" href={`/tags/${term.slug}/`}>
            <span class="term-name">#{term.name}</span>
            <span class="term-count">{term.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
