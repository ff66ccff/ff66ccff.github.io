---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import FriendCard from '../components/FriendCard.astro';
import { getPublishedPosts, collectTerms } from '../lib/posts';
import { friends } from '../lib/site';

const posts = await getPublishedPosts();
const categories = collectTerms(posts, 'categories');
const tags = collectTerms(posts, 'tags').slice(0, 10);
const friendsAll = friends.flatMap((group) => group.items).slice(0, 4);
---

<BaseLayout>
  <Hero />

  <div class="container">
    <section class="section" aria-labelledby="latest-title">
      <div class="section-head">
        <h2 class="section-title" id="latest-title">最新文章</h2>
        <a class="section-more" href="/archives/">全部文章 →</a>
      </div>
      {
        posts.length > 0 ? (
          <div class="post-list">
            {posts.map((post, index) => (
              <PostCard post={post} featured={index === 0} />
            ))}
          </div>
        ) : (
          <p class="empty-note">还没有文章，去写第一篇吧。</p>
        )
      }
    </section>

    <section class="section" aria-labelledby="categories-title">
      <div class="section-head">
        <h2 class="section-title" id="categories-title">分类</h2>
        <a class="section-more" href="/categories/">全部分类 →</a>
      </div>
      <ul class="taxonomy-grid">
        {
          categories.map((term) => (
            <li>
              <a class="term-card" href={`/categories/${term.slug}/`}>
                <span class="term-name">{term.name}</span>
                <span class="term-count">{term.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="tags-title">
      <div class="section-head">
        <h2 class="section-title" id="tags-title">标签</h2>
        <a class="section-more" href="/tags/">全部标签 →</a>
      </div>
      <div class="tag-cloud">
        {tags.map((term) => (
          <a class="tag" href={`/tags/${term.slug}/`}>
            #{term.name} <span class="term-count">{term.count}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="friends-title">
      <div class="section-head">
        <h2 class="section-title" id="friends-title">朋友们</h2>
        <a class="section-more" href="/friends/">全部友链 →</a>
      </div>
      <ul class="friends-grid">
        {friendsAll.map((item) => (
          <li>
            <FriendCard item={item} />
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
